    "test:https-guard-fuzz": "node --test --experimental-strip-types tests/https-guard-fuzz.test.mjs",
    "fuzz:replay": "node --experimental-strip-types scripts/replay-fuzz-failure.mjs",
    "fuzz:report": "node --experimental-strip-types scripts/report-fuzz-failure.mjs",
    "test:security-headers-e2e": "node --test tests/security-headers-e2e.test.mjs",
    "test": "npm run test:headers && npm run test:clickjacking && npm run test:error-page-clickjacking && npm run test:csp-hash && npm run test:consent && npm run test:https-guard-host && npm run test:https-guard-fuzz && npm run test:security-headers-e2e && npm run test:time-provider && npm run test:trusted-gh && npm run test:policy",
    "test:time-provider": "node --experimental-strip-types src/lib/time/provider.test.ts"
